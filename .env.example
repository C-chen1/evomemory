# API 配置模板
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中排除。
#
# 模型名必须显式填写 —— 代码不会猜模型 id。
# 请先在项目里确认当前 provider 支持的模型列表（见 docs/NEXT_STEPS.md）。

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 调用预算（硬上限，超出即抛 BudgetExceeded 并停止新请求）
EVOMEMORY_MAX_CALLS=200
EVOMEMORY_MAX_TOKENS=500000
EVOMEMORY_TEMPERATURE=0.0
